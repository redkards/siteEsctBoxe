@startuml usecase

title = "Use Case ESCT Boxe"

left to right direction

actor Membre as m
actor Administrateur as a
actor Visiteur as v

package "Membre" as packM {
    useCase "S'inscrire" as signUp
    useCase "Se connecter" as logIn
    useCase "Mettre à jour son profil" as updateProfile
    useCase "Consulter les événements" as viewEvents
    useCase "Participer à un événement" as participateEvent
    useCase "Laisser un commentaire" as leaveComment
    useCase "Consulter la galerie" as viewGallery

    m --> packM
}

package "Administrateur" as packA {
    useCase "Se connecter" as adminLogIn
    useCase "Gérer les membres" as manageMembers
    useCase "Gérer les événements" as manageEvents
    useCase "Gérer les actualités" as manageNews
    useCase "Gérer les commentaires" as manageComments
    useCase "Gérer la galerie" as manageGallery

    a --> packA
}

package "Visiteur" as packV {
    useCase "Consulter les événements" as viewEventsV
    useCase "Consulter les actualités" as viewNews
    useCase "Consulter la galerie" as viewGalleryV

    v --> packV
}

useCase "Connexion" as connect

packM ..> connect : includes 
packA ..> connect : includes 
packV ..> connect : includes 

@enduml

