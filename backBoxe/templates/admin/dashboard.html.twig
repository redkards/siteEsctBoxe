{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block main %}
    <h2 class="h5 mb-3">À traiter</h2>
    <div class="row g-3">
        {% for item in todo %}
            <div class="col-sm-6 col-xl-3">
                <a class="card h-100 text-decoration-none {{ item.value > 0 ? 'border-warning' : '' }}" href="{{ ea_url().setController(item.controller).setAction('index') }}">
                    <div class="card-body">
                        <div class="text-muted small"><i class="{{ item.icon }}"></i> {{ item.label }}</div>
                        <div class="fs-2 fw-bold">{{ item.value }}</div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>

    <h2 class="h5 mt-4 mb-3">Le club en chiffres</h2>
    <div class="row g-3">
        {% for label, value in stats %}
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">{{ label }}</div>
                        <div class="fs-2 fw-bold">{{ value }}</div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <p class="mt-4 text-muted">
        Une actualité sans date de publication reste un brouillon ; une date future programme sa mise en ligne.
        Un événement n'apparaît sur le site qu'une fois coché « Publié ».
    </p>
{% endblock %}
