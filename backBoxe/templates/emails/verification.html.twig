{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:22px;color:#c8102e;">Bienvenue à l'ESCT Boxe, {{ firstName }} 🥊</h1>
    <p style="margin:0 0 16px;line-height:1.5;">
        Merci pour la création de votre compte. Pour l'activer, confirmez votre adresse email :
    </p>
    <p style="margin:24px 0;text-align:center;">
        <a href="{{ link }}" style="display:inline-block;padding:12px 24px;background:#c8102e;color:#ffffff;text-decoration:none;font-weight:bold;border-radius:6px;">
            Confirmer mon adresse
        </a>
    </p>
    <p style="margin:0 0 16px;line-height:1.5;font-size:14px;color:#555;">
        Ce lien est valable jusqu'au {{ expiresAt|date('d/m/Y à H:i', 'Europe/Paris') }}.
        Si vous n'êtes pas à l'origine de cette inscription, ignorez simplement cet email.
    </p>
    <p style="margin:0;font-size:12px;color:#888;word-break:break-all;">Lien direct : {{ link }}</p>
{% endblock %}
