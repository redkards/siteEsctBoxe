{% extends 'base.html.twig' %}

{% block title %}Palmares index{% endblock %}

{% block body %}
    <h1>Palmares index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Victoires</th>
                <th>Defaites</th>
                <th>Nul</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for palmare in palmares %}
            <tr>
                <td>{{ palmare.id }}</td>
                <td>{{ palmare.victoires }}</td>
                <td>{{ palmare.defaites }}</td>
                <td>{{ palmare.nul }}</td>
                <td>
                    <a href="{{ path('app_palmares_show', {'id': palmare.id}) }}">show</a>
                    <a href="{{ path('app_palmares_edit', {'id': palmare.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_palmares_new') }}">Create new</a>
{% endblock %}
